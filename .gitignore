# Локальное состояние Quarto; стандартные записи сохраняются без изменений.
/.quarto/
**/.quarto/
**/*.quarto_ipynb
/_*.local

# Результаты сборки, сгенерированные модели курса и кеши во всех каталогах.
**/.qrc/
**/_generated/
**/_site/
**/_book/
**/_output/
**/site_libs/
**/*_files/
**/*_cache/

.DS_Store

# Установленные зависимости примеров; исходники в /_extensions хранятся в Git.
/examples/**/_extensions/

# Результаты локальной компиляции примеров на Java.
/examples/**/*.class
/examples/**/build/
/examples/**/.gradle/
/examples/**/out/

# Зависимости, которые получает CI.
/.ci-deps/

# Частное состояние авторской попытки Core.
**/.course-owner/
