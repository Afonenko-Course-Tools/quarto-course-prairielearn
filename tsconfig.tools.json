{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "tools/**/*.cjs",
    "tools/**/*.mjs",
    "tests/**/*.cjs",
    "tests/**/*.mjs",
    "*.mjs",
    "*.cjs"
  ]
}
